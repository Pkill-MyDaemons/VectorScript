// A gorgeous 3-color sunset gradient!
Box bg = new Box(0, 0, 240, 240) { gradient: "#F38BA8,#CBA6F7,#89B4FA" };

Text clock = new Text(0, 0, "12:00") { fill: "#11111B", size: 48 };
Box time_box = new Box(0, 0, 200, 60) { align: "center", child: clock };

Box app_btn = new Box(0, 0, 200, 40) { 
    fill: "#11111B", align: "center", onClick: "route:apps.ves",
    child: new Text("Open Apps") { fill: "#A6E3A1", size: 16 }
};

Box settings_btn = new Box(0, 0, 200, 40) { 
    fill: "#11111B", align: "center",
    child: new Text("Settings") { fill: "#F9E2AF", size: 16 }
};

// Throw them all into an Auto-Layout Stack!
// We define it once at X:20, Y:40, and it pushes everything else down perfectly.
VStack menu = new VStack(20, 40, 200, 200) {
    spacing: 15,
    child: time_box,
    child: app_btn,
    child: settings_btn
};